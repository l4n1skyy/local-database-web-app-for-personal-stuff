#!/usr/bin/env python3
"""db: my SQLite databases (Chinese vocabulary, workouts, finance, quotes, knowledge bits),
browsed with Datasette.

Usage:
  db [open]        sync, back up once a day, start Datasette and open it in the browser
  db restart       stop and start Datasette again, without opening the browser
  db stop          stop Datasette
  db sync          move learnt words you haven't studied for N days to "to revise"
  db import FILE   add Chinese words from a CSV, or finance data: a Google Forms
                   responses CSV (expenses, savings, shares) or a budget TSV.
                   Rows already in the database are skipped.
  db backup        copy the databases into backups/ now
  db status        is Datasette running, and a line about each database
  db autostart     start Datasette whenever you log in (a systemd user service)
  db autostart off stop doing that
  db serve         run Datasette in the foreground (what the service runs)

Everything lives in this repo's folder (the one above bin/); DB_DIR overrides it.
"""

import csv
import os
import shutil
import signal
import sqlite3
import subprocess
import sys
import time
import urllib.request
from collections import Counter
from datetime import date, datetime
from pathlib import Path

DB_DIR = Path(os.environ.get("DB_DIR", Path(__file__).resolve().parent.parent))
DATABASES = ("chinese", "workouts", "finance", "quotes", "knowledge")
STATE_DIR = Path.home() / ".local/state/db"
PID_FILE = STATE_DIR / "datasette.pid"
LOG_FILE = STATE_DIR / "datasette.log"
DATASETTE = Path(shutil.which("datasette") or Path.home() / ".local/bin/datasette")
PORT = 8001
URL = f"http://127.0.0.1:{PORT}/"
KEEP_BACKUPS = 14  # per database
SERVICE = "db.service"
UNIT_FILE = Path.home() / ".config/systemd/user" / SERVICE
UNIT = """\
[Unit]
Description=Datasette for my databases (written by `db autostart`)
# Give up after 5 failed starts in 5 minutes (e.g. the drive isn't mounted)
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=exec
Environment="DB_DIR={dir}"
ExecStart="{db}" serve
# Not after a clean exit: `db stop` ends it with SIGTERM
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
"""

STATUSES = {"to learn": "to learn", "to revise": "to revise", "learnt": "learnt", "learned": "learnt"}
# CSV header (lowercased, spaces -> _) -> words column
WORD_COLUMNS = {
    "character": "character", "hanzi": "character", "chinese": "character", "word": "character",
    "pinyin": "pinyin",
    "english": "english", "meaning": "english",
    "notes": "notes", "note": "notes",
    "type": "type",
    "category": "category",
    "hsk": "hsk", "hsk_level": "hsk", "level": "hsk",
    "status": "status", "list": "status",
    "last_studied": "last_studied",
    "date_added": "date_added",
}


def die(msg):
    print(f"db: {msg}", file=sys.stderr)
    if not sys.stderr.isatty():  # started from the app launcher
        subprocess.run(["notify-send", "-u", "critical", "db", msg[:500]], check=False)
    sys.exit(1)


def connect(name):
    if not DB_DIR.is_dir():
        die(f"{DB_DIR} doesn't exist (is the drive it lives on mounted?)")
    conn = sqlite3.connect(DB_DIR / f"{name}.db")
    conn.row_factory = sqlite3.Row
    # Create anything missing and rebuild views/triggers from schema/<name>.sql
    conn.executescript((DB_DIR / "schema" / f"{name}.sql").read_text())
    return conn


def list_counts(conn):
    counts = dict(conn.execute("SELECT status, count(*) FROM words GROUP BY status").fetchall())
    return " · ".join(f"{s} {counts.get(s, 0)}" for s in ("to learn", "to revise", "learnt"))


def sync(quiet=False):
    with connect("chinese") as conn:
        days = conn.execute("SELECT value FROM settings WHERE key = 'revise_after_days'").fetchone()[0]
        # The same rule the app runs every few minutes
        moved = conn.execute((DB_DIR / "schema" / "sync.sql").read_text()).rowcount
        if not quiet or moved:
            print(f"Moved {moved} word{'s' * (moved != 1)} not studied for {days}+ days to \"to revise\".")
        if not quiet:
            print(f"Lists: {list_counts(conn)}")
    conn.close()


def backup(force=False):
    folder = DB_DIR / "backups"
    folder.mkdir(exist_ok=True)
    made = []
    for name in DATABASES:
        target = folder / f"{name}-{date.today()}.db"
        if target.exists() and not force:
            continue
        src = connect(name)
        dst = sqlite3.connect(target)
        src.backup(dst)
        dst.close()
        src.close()
        made.append(target.name)
        for old in sorted(folder.glob(f"{name}-*.db"))[:-KEEP_BACKUPS]:
            old.unlink()
    return made


def running():
    try:
        with urllib.request.urlopen(URL + "-/versions.json", timeout=1):
            return True
    except OSError:
        return False


def systemctl(*args):
    return subprocess.run(["systemctl", "--user", *args], check=False).returncode


def datasette_command():
    if not DATASETTE.exists():
        die("Datasette isn't installed: uv tool install --prerelease=allow 'datasette==1.0a41'")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    return [str(DATASETTE), "serve", str(DB_DIR), "--host", "127.0.0.1", "--port", str(PORT)]


def prepare():
    for name in DATABASES:
        connect(name).close()
    sync(quiet=True)
    backup()


def start():
    prepare()
    if not running():
        command = datasette_command()
        if UNIT_FILE.exists():  # db autostart: let systemd run it
            systemctl("start", SERVICE)
            stopped = lambda: systemctl("-q", "is-active", SERVICE) != 0
        else:
            with open(LOG_FILE, "a") as log:
                proc = subprocess.Popen(
                    command, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True,
                )
            PID_FILE.write_text(str(proc.pid))
            stopped = lambda: proc.poll() is not None
        for _ in range(100):
            if running():
                break
            if stopped():
                die(f"Datasette stopped while starting:\n{LOG_FILE.read_text()[-2000:]}")
            time.sleep(0.2)
        else:
            die(f"Datasette didn't answer on {URL}, see {LOG_FILE}")
    print(f"Datasette is running at {URL}")


def open_():
    start()
    subprocess.Popen(["xdg-open", URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def stop():
    try:
        pid = int(PID_FILE.read_text())
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (OSError, ValueError):
        cmdline = b""
    if b"datasette" not in cmdline:
        print("Datasette isn't running." if not running() else f"Datasette on port {PORT} wasn't started by db.")
        return
    os.kill(pid, signal.SIGTERM)
    PID_FILE.unlink(missing_ok=True)
    print("Stopped Datasette.")


def restart():
    stop()
    for _ in range(50):
        if not running():
            break
        time.sleep(0.1)
    start()


def serve():
    prepare()
    command = datasette_command()
    # Become Datasette, logging where `db open` logs; the pid stays the same, so `db stop` works too
    sys.stdout.flush()
    log = os.open(LOG_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(log, 1)
    os.dup2(log, 2)
    PID_FILE.write_text(str(os.getpid()))
    os.execv(command[0], command)


def autostart(on):
    if not on:
        if UNIT_FILE.exists():
            systemctl("-q", "disable", SERVICE)
            UNIT_FILE.unlink()
            systemctl("daemon-reload")
        print("Datasette won't start when you log in any more (`db stop` stops it now).")
        return
    UNIT_FILE.parent.mkdir(parents=True, exist_ok=True)
    UNIT_FILE.write_text(UNIT.format(db=Path(__file__).resolve(), dir=DB_DIR))
    systemctl("daemon-reload")
    systemctl("-q", "enable", SERVICE)
    if systemctl("-q", "is-active", SERVICE) != 0:
        restart() if running() else start()  # hand a Datasette started by `db open` over to the service
    print(f"Datasette now starts when you log in (systemctl --user status {SERVICE}).")


def import_words(path):
    path = Path(path).expanduser()
    if not path.is_file():
        die(f"no such file: {path}")
    with open(path, newline="", encoding="utf-8-sig") as f:
        reader = csv.DictReader(f)
        mapping = {h: WORD_COLUMNS[k] for h in reader.fieldnames or []
                   if (k := h.strip().lower().replace(" ", "_")) in WORD_COLUMNS}
        if "character" not in mapping.values():
            die(f"{path.name} needs a character (or Hanzi) column; it has: {', '.join(reader.fieldnames or [])}")
        ignored = [h for h in reader.fieldnames if h not in mapping]
        rows = []
        for n, raw in enumerate(reader, start=2):
            row = {col: (raw[h] or "").strip() for h, col in mapping.items()}
            if not row.get("character"):
                continue
            if row.get("status"):
                if row["status"].lower() not in STATUSES:
                    die(f"line {n}: unknown status {row['status']!r} (use to learn, to revise or learnt)")
                row["status"] = STATUSES[row["status"].lower()]
            # Blank optional fields: let the column default (or NULL) apply
            rows.append({k: v for k, v in row.items() if v or k in ("pinyin", "english", "notes")})
    added = skipped = 0
    with connect("chinese") as conn:
        for row in rows:
            if conn.execute("SELECT 1 FROM words WHERE character = ? AND pinyin = ?",
                            (row["character"], row.get("pinyin", ""))).fetchone():
                skipped += 1
                continue
            cols = ", ".join(row)
            marks = ", ".join(f":{c}" for c in row)
            try:
                conn.execute(f"INSERT INTO words ({cols}) VALUES ({marks})", row)
            except sqlite3.IntegrityError as e:
                die(f"can't add {row['character']} ({e}); nothing was imported")
            added += 1
        print(f"Added {added} words, skipped {skipped} already in the database.")
        if ignored:
            print(f"Columns not imported: {', '.join(ignored)}")
        print(f"Lists: {list_counts(conn)}")
    conn.close()


def import_file(path):
    """Chinese words, or finance data if the file looks like the finance sheets."""
    path = Path(path).expanduser()
    if not path.is_file():
        die(f"no such file: {path}")
    with open(path, newline="", encoding="utf-8-sig") as f:
        head = f.read(4096)
    if "\t" in head and "Daily" in head and "Monthly" in head:
        import_budget(path)
    elif "Transaction Type" in head.partition("\n")[0]:
        import_finance(path)
    else:
        import_words(path)


def money(text):
    """'RM1,200.00', '5.9' or '' -> 1200.0, 5.9 or None"""
    text = text.strip().upper().removeprefix("RM").replace(",", "").strip()
    return round(float(text), 2) if text else None


def form_date(text):
    """A Google Forms timestamp ('30/08/2026 20:20:36' or '29/08/2026') -> '2026-08-30'"""
    return datetime.strptime(text.split()[0], "%d/%m/%Y").date().isoformat()


FINANCE_COLUMNS = {
    "expenses": ("date", "category", "amount", "notes"),
    "balances": ("date", "account", "balance", "notes"),
    "trades": ("date", "ticker", "side", "shares", "price", "commission", "notes"),
}


def import_finance(path):
    """A Google Forms responses CSV. Expenses rows become expenses; Savings rows become
    account balances, or share purchases (trades) when the account type is Investment."""
    with open(path, newline="", encoding="utf-8-sig") as f:
        found = list(csv.DictReader(f))
    new = {table: [] for table in FINANCE_COLUMNS}
    problems = []
    # The export lists the newest first; add the oldest first so ids follow the order you logged them
    for n, r in reversed(list(enumerate(found, start=1))):
        col = lambda name: (r.get(name) or "").strip()
        kind, account, notes = col("Transaction Type").lower(), col("Account Type"), col("Notes")
        try:
            day = form_date(col("Timestamp"))
            if kind == "expenses":
                amount = money(col("Amount (MYR)"))
                if not amount or amount < 0:
                    raise ValueError("no amount")
                new["expenses"].append((day, col("Category") or "Other", amount, notes))
            elif kind == "savings" and account.lower() == "investment":
                new["trades"].append((day, col("Ticker"), "buy", float(col("Number of Shares")),
                                           float(col("Price per Share (USD)")), float(col("Commission (USD)") or 0), notes))
            elif kind == "savings":
                amount = money(col("Amount (MYR)"))
                if amount is None:
                    raise ValueError("no amount")
                new["balances"].append((day, account or "Savings", amount, notes))
            else:
                raise ValueError(f"unknown transaction type {col('Transaction Type')!r}")
        except ValueError as e:
            problems.append(f"row {n}: {e}")
    with connect("finance") as conn:
        for table, cols in FINANCE_COLUMNS.items():
            # Skip rows that are already there, counting repeats: two identical RM2 coffees on
            # one day stay two, and importing the same export again adds nothing
            key = lambda row: tuple(v.lower() if isinstance(v, str) else v for v in row)
            have = Counter(key(r) for r in conn.execute(f"SELECT {', '.join(cols)} FROM {table}"))
            added = 0
            for row in sorted(new[table], key=lambda row: row[0]):
                if have[key(row)]:
                    have[key(row)] -= 1
                    continue
                conn.execute(f"INSERT INTO {table} ({', '.join(cols)}) VALUES ({', '.join('?' * len(cols))})", row)
                added += 1
            print(f"{table.capitalize()}: added {added}, skipped {len(new[table]) - added} already in the database.")
    conn.close()
    if problems:
        print(f"Not imported ({len(problems)}): " + "; ".join(problems))


def import_budget(path):
    """The Budget sheet saved as TSV: a header row with Daily, Amount, Monthly, Amount, then
    one category per row under each, down to its Total row. It replaces the whole budget."""
    with open(path, newline="", encoding="utf-8-sig") as f:
        table = [[c.strip() for c in cells] for cells in csv.reader(f, delimiter="\t")]
    header = next((i for i, cells in enumerate(table) if "Daily" in cells and "Monthly" in cells), None)
    if header is None:
        die(f"{path.name} has no header row with Daily and Monthly columns")
    lines = []
    for period in ("Daily", "Monthly"):
        c = table[header].index(period)
        for cells in table[header + 1:]:
            name = cells[c] if c < len(cells) else ""
            if name.lower() == "total":
                break
            if not name:
                continue
            try:
                amount = money(cells[c + 1] if c + 1 < len(cells) else "")
            except ValueError:
                amount = None
            if amount is None:
                die(f"{period} budget: {name} has no amount")
            lines.append((period.lower(), len(lines), name, amount))
    if not lines:
        die(f"{path.name} has no budget lines under Daily or Monthly")
    with connect("finance") as conn:
        conn.execute("DELETE FROM budget")
        try:
            conn.executemany("INSERT INTO budget (period, position, category, amount) VALUES (?, ?, ?, ?)", lines)
        except sqlite3.IntegrityError as e:
            die(f"can't import the budget ({e}); nothing was changed")
        for period in ("daily", "monthly"):
            n, total = conn.execute("SELECT count(*), coalesce(sum(amount), 0) FROM budget WHERE period = ?", [period]).fetchone()
            print(f"{period.capitalize()} budget: {n} categories, RM{total:,.2f}")
    conn.close()


def status():
    print(f"Datasette: {'running at ' + URL if running() else 'not running'}")
    with connect("chinese") as conn:
        print(f"Chinese: {list_counts(conn)}")
    conn.close()
    with connect("workouts") as conn:
        row = conn.execute("SELECT count(DISTINCT date) AS workouts, count(*) AS sets, max(date) AS last FROM sets").fetchone()
        print(f"Workouts: {row['workouts']} workouts, {row['sets']} sets, last on {row['last'] or '-'}")
    conn.close()
    with connect("finance") as conn:
        row = conn.execute("""SELECT coalesce(sum(CASE WHEN date >= date('now', 'localtime', 'start of month') THEN amount END), 0) AS month,
                                     max(date) AS last FROM expenses""").fetchone()
        budget = conn.execute("SELECT sum(amount) FROM budget WHERE period = 'monthly'").fetchone()[0]
        print(f"Finance: RM{row['month']:,.2f} spent this month" + (f" of RM{budget:,.2f}" if budget else "")
              + f", last expense on {row['last'] or '-'}")
    conn.close()
    for name, table, title in (("quotes", "quotes", "Quotes"), ("knowledge", "bits", "Knowledge")):
        with connect(name) as conn:
            n, tags = conn.execute(f"SELECT (SELECT count(*) FROM {table}), (SELECT count(*) FROM tags)").fetchone()
            print(f"{title}: {n} {table}, {tags} tags")
        conn.close()


def main(args):
    cmd = args[0] if args else "open"
    if cmd == "open" and len(args) <= 1:
        open_()
    elif cmd == "stop":
        stop()
    elif cmd == "restart":
        restart()
    elif cmd == "serve":
        serve()
    elif cmd == "autostart" and args[1:] in ([], ["off"]):
        autostart(on=not args[1:])
    elif cmd == "sync":
        sync()
    elif cmd == "import" and len(args) == 2:
        import_file(args[1])
    elif cmd == "backup":
        made = backup(force=True)
        print(f"Backed up into {DB_DIR / 'backups'}: {', '.join(made)}")
    elif cmd == "status":
        status()
    elif cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
